# Valores sensíveis para o Backup Guardian.
# Copie este arquivo para conf/arquivo.env (NÃO versionado, veja .gitignore)
# e preencha com TODAS as configurações da sua aplicação.
#
#   cp conf/env.example conf/arquivo.env
#   nano conf/arquivo.env
#
# Este arquivo é lido por conf/arquivo.conf. Em produção, quando o install.sh
# copiar os arquivos para /etc/backup-guardian/conf.d/, o arquivo.env também
# é copiado (e preservado em atualizações futuras).

# ============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ============================================================================

# Nome descritivo da aplicação
APP_NAME="Minha Aplicação"

# Identificador único (usado em nomes de arquivo, sem espaços)
APP_ID="minha_aplicacao"

# Diretório raiz onde os backups serão salvos
# O sistema criará: ${BACKUP_ROOT}/${APP_ID}_arquivos/
#
# Exemplos:
#   BACKUP_ROOT="/backups"                → /backups/minha_aplicacao_arquivos/
#   BACKUP_ROOT="/mnt/storage"            → /mnt/storage/minha_aplicacao_arquivos/
#   BACKUP_ROOT="/dados/backups"          → /dados/backups/minha_aplicacao_arquivos/
#
BACKUP_ROOT="/backups"

# Grupo de permissões (deve existir no sistema)
GROUP="backup-users"

# Permissões dos diretórios (opcional, padrão: 2775)
# DIR_PERMS="2775"

# ============================================================================
# GERENCIAMENTO DE ESPAÇO EM DISCO
# ============================================================================

# Margem de segurança mínima em MB que deve sempre restar no disco
# O sistema calcula: tamanho_do_backup + MIN_FREE_SPACE_MB
# Se o espaço disponível for menor, o backup é abortado
#
# Exemplos:
#   MIN_FREE_SPACE_MB=51200    → Mantém 50GB livres (padrão)
#   MIN_FREE_SPACE_MB=102400   → Mantém 100GB livres
#   MIN_FREE_SPACE_MB=10240    → Mantém 10GB livres
#
# Padrão: 51200 MB (50 GB)
MIN_FREE_SPACE_MB=51200

# Quantos meses de backups mensais manter antes de deletar automaticamente
# Padrão: 12 meses
KEEP_MONTHS=12

# ============================================================================
# NOTIFICAÇÕES
# ============================================================================

# Destinatário das notificações de backup/erro
EMAIL_TO="destinatario@example.com"

# ============================================================================
# CAMINHOS MONITORADOS
# ============================================================================

# Defina os caminhos absolutos dos arquivos/pastas para backup
# Adicione quantos CAMINHO_N precisar (não há limite)
CAMINHO_1="/var/www/aplicacao/public"
CAMINHO_2="/var/www/aplicacao/.env"
CAMINHO_3="/var/www/api/uploads"
CAMINHO_4="/etc/nginx/sites-available/app.conf"
# CAMINHO_5="/outro/caminho/qualquer"
# CAMINHO_6="/mais/um/caminho"
# ... adicione quantos precisar

# ============================================================================
# MAPEAMENTO DE ITENS NO ZIP
# ============================================================================

# ITEMS define como organizar os arquivos DENTRO do arquivo ZIP de backup.
# 
# Formato: "${CAMINHO_N}|pasta/arquivo"
#           ↑              ↑
#        usa a variável   nome que terá no ZIP (você escolhe)
#
# EXEMPLO DIDÁTICO:
# Imagine que você definiu:
#   CAMINHO_1="/srv/loja/imagens"
#   CAMINHO_2="/srv/loja/config.json"
#   CAMINHO_3="/opt/scripts/backup.sh"
#
# E configurou ITEMS assim:
#   ITEMS=(
#     "${CAMINHO_1}|loja/imagens"
#     "${CAMINHO_2}|loja/config.json"
#     "${CAMINHO_3}|scripts/backup.sh"
#   )
#
# Resultado - o ZIP terá esta estrutura:
#   meu_backup.zip
#   ├── loja/
#   │   ├── imagens/        ← todo conteúdo de /srv/loja/imagens
#   │   └── config.json     ← cópia de /srv/loja/config.json
#   └── scripts/
#       └── backup.sh       ← cópia de /opt/scripts/backup.sh
#
# REGRA SIMPLES: 
# - Lado esquerdo (${CAMINHO_N}) → sempre use a variável
# - Lado direito (depois do |) → escolha um nome organizado para o ZIP
# - Não coloque / no início do lado direito

ITEMS=(
  "${CAMINHO_1}|app/public"
  "${CAMINHO_2}|app/.env"
  "${CAMINHO_3}|api/uploads"
  "${CAMINHO_4}|config/nginx.conf"
)
